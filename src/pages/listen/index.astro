---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Navigation from '@/components/Navigation.astro';
---
<SiteLayout title="Kathleen Purcell Flute Studios: Samples">
<img src="/KPFS1.jpg" />
<table width="960">
 <tbody><tr><td width="175"></td>
     <td>

<Navigation />

</td>
 </tr>
</tbody></table>
<table>
 <tbody><tr>
     <td width="10"></td><td>
    <i><b>Excerpts from live performances</b></i></td>
   </tr>
</tbody></table>

<script is:inline src="modernizr.custom.js"></script>
<script is:inline src="//ajax.googleapis.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
<script is:inline src="js.cookie.js"></script>
<link rel="stylesheet" href="ableplayer.min.css" type="text/css" />
<script is:inline src="ableplayer.js"></script>

<audio id="audio1" width="525" preload="auto" data-able-player="" data-root-path="." data-speed-icons="none">
</audio>

<ul class="able-playlist" data-player="audio1" data-embedded="">
  <li data-mp3="doppler-excerpt.mp3">Mazurka de Salon Op. 16 by Franz Doppler (excerpt)</li>
  <li data-mp3="brian-boru-excerpt-applause.mp3">Brian Boru's March (excerpt)</li>
  <li data-mp3="vivaldi-piccolo-concerto-excerpt.mp3">Piccolo Concerto in C Op. 44 No. 11 by Antonio Vivaldi (excerpt)</li>
  <li data-mp3="albinoni-adagio-excerpt.mp3">Adagio in g by Remo Giazotto, based on a theme by Tomaso Albinoni (excerpt)</li>
  <li data-mp3="dohnanyi-aria-excerpt-applause.mp3">Aria Op. 48, No. 1 by Ernst von Dohnanyi (excerpt)</li>
</ul>


</SiteLayout>
