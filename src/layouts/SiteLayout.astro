---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <link rel="stylesheet" href="/style.css" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/vnd.microsoft.icon" />
  </head>
  <body>
    <slot />
    <script is:inline src="//www.google-analytics.com/urchin.js"></script>
    <script is:inline>
      window._uacct = 'UA-296763-3';
      if (typeof urchinTracker === 'function') urchinTracker();
    </script>
  </body>
</html>
